# ==============================================================================
# AgriTech AI Vision Microservice Environment Configuration Template
# Copy to .env for local overrides
# ==============================================================================

# Runtime Environment
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Cross-Origin Resource Sharing (CORS) - empty: only the backend calls this service
CORS_ORIGINS=[]

# Service-to-service auth: must match INTERNAL_API_KEY in apps/backend
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_KEY=

# Groq LLM for the RAG advisor (server-side only, never expose to the browser)
GROQ_API_KEY=
# Text-only turns use GROQ_MODEL; turns with photos use GROQ_VISION_MODEL (falls back to GROQ_MODEL on error)
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# ONNX Runtime CPU Threadpool & Performance Configuration
# Sequential execution + tuned intra-op threads prevents core contention on CPU
ONNX_INTER_OP_NUM_THREADS=1
ONNX_INTRA_OP_NUM_THREADS=4
ONNX_EXECUTION_MODE=ORT_SEQUENTIAL
ONNX_GRAPH_OPTIMIZATION_LEVEL=ORT_ENABLE_ALL
WARMUP_ON_STARTUP=true

# Vision Pipeline Parameters
DETECTOR_INPUT_SIZE=640
DETECTOR_CONF_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.45
CLASSIFIER_INPUT_SIZE=224
CLASSIFIER_TOP_K=5
CROP_PADDING_RATIO=0.10
