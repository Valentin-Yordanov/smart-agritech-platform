# ==============================================================================
# AgriTech AI Vision Microservice Environment Configuration Template
# Copy to .env for local overrides
# ==============================================================================

# Runtime Environment
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["*"]

# ONNX Runtime CPU Threadpool & Performance Configuration
# Sequential execution + tuned intra-op threads prevents core contention on CPU
ONNX_INTER_OP_NUM_THREADS=1
ONNX_INTRA_OP_NUM_THREADS=4
ONNX_EXECUTION_MODE=ORT_SEQUENTIAL
ONNX_GRAPH_OPTIMIZATION_LEVEL=ORT_ENABLE_ALL
WARMUP_ON_STARTUP=true

# Vision Pipeline Parameters
DETECTOR_INPUT_SIZE=640
DETECTOR_CONF_THRESHOLD=0.25
DETECTOR_IOU_THRESHOLD=0.45
CLASSIFIER_INPUT_SIZE=224
CLASSIFIER_TOP_K=5
CROP_PADDING_RATIO=0.10
