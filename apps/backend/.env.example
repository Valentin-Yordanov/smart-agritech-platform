# Smart AgriTech backend - copy to .env and fill in. Never commit real values.

NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Required in production (min 32 chars each). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Required in production: comma-separated frontend origins, no "*"
CORS_ORIGIN=https://your-app.vercel.app

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=leaf-diagnoses
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
# Private bucket (no r2.dev public access) for chat attachments; same R2 credentials
R2_PRIVATE_BUCKET_NAME=leaf-chat-private

# Max messages with attachments per user per 24 h (protects the shared Groq free tier)
CHAT_ATTACHMENT_DAILY_LIMIT=20

# AI microservice + shared secret (must equal INTERNAL_API_KEY in apps/ai-service)
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=
